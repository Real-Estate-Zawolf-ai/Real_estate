# Comma-separated browser origins (CORS + voice WebSocket). "*" only for local dev.
CORS_ALLOWED_ORIGINS=*
# HMAC key for chat sessions and voice tokens (generate: python -c "import secrets;print(secrets.token_hex(32))").
SESSION_SECRET=
# Required (X-Admin-Key header) for POST /properties and POST /documents/ingest. Blank = disabled.
ADMIN_API_KEY=

GROQ_API_KEY=

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
VOICE_TOKEN_TTL_SECONDS=60
VOICE_MAX_SESSION_SECONDS=600
VOICE_IDLE_TIMEOUT_SECONDS=90
VOICE_MAX_CONCURRENT_SESSIONS=20

# Viewing scheduling (local business hours for bookable slots)
VIEWING_TIMEZONE=Africa/Cairo
VIEWING_DAY_START_HOUR=10
VIEWING_DAY_END_HOUR=18
VIEWING_SLOT_MINUTES=60

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Only for the optional open-wa gateway (app/channels/whatsapp.ts).
WHATSAPP_GATEWAY_SECRET=

QDRANT_API_KEY=""
QDRANT_URL=""
QDRANT_COLLECTION=properties

# PostgreSQL
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=real_estate

# File ingestion (bytes; blank means no explicit application limit)
FILE_MAX_SIZE=
FILE_DEFAULT_CHUNK_SIZE=1500
FILE_CHUNK_OVERLAP=100

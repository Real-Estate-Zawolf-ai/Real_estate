# Aqar.ai configuration. Copy to `.env` for local development; in production set these
# as environment variables in the host's dashboard (Render) - never commit real values.
# `python scripts/check_env.py` validates the result without printing any secret.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production. "production" refuses to start with unsafe settings
# (wildcard CORS, missing secrets, local Qdrant, ...) and closes /docs and /metrics.
APP_ENV=development
LOG_LEVEL=INFO
# "json" for Render / log drains, "text" for a terminal.
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API and open the voice WebSocket (comma-separated,
# https in production). "*" is for local development only and is refused in production.
CORS_ALLOWED_ORIGINS=*
# Signs website session ids and voice tokens. >= 32 chars.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# How long a website session id stays valid (it is re-signed on use, so active chats keep going).
SESSION_MAX_AGE_DAYS=30
# Staff API key (X-Admin-Key header): confirm bookings, manage hand-offs, index properties. >= 24 chars.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Number of reverse proxies in front of the app. Render = 1. 0 ignores X-Forwarded-For.
# Check it after deploying: GET /admin/diagnostics/client-ip must show YOUR address.
TRUSTED_PROXY_HOPS=0
# Per-process request limits (defaults shown). Set RATE_LIMIT_ENABLED=false only for local debugging.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CHAT_PER_MINUTE=20
# RATE_LIMIT_CHAT_SESSION_PER_MINUTE=12
# RATE_LIMIT_SESSION_CREATE_PER_HOUR=30
# RATE_LIMIT_SEARCH_PER_MINUTE=15
# RATE_LIMIT_VOICE_TOKEN_PER_MINUTE=6
# RATE_LIMIT_LEADS_PER_HOUR=10
# RATE_LIMIT_ADMIN_FAILURES_PER_15MIN=8
# RATE_LIMIT_WHATSAPP_SENDER_PER_MINUTE=15

# ---------------------------------------------------------------------------
# PostgreSQL (Neon)  - conversations, CRM, bookings, hand-offs
# ---------------------------------------------------------------------------
# Neon dashboard -> Connect -> turn OFF "Connection pooling" -> copy the *direct* string.
# Keep ?sslmode=require. Special characters in the password must be percent-encoded.
DATABASE_URL=
# Alternative to DATABASE_URL (local Docker): the parts are escaped for you.
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=real_estate

# ---------------------------------------------------------------------------
# Vector search (Qdrant Cloud) + embeddings + reranking
# ---------------------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=properties
# gemini (hosted, default) | local (sentence-transformers; needs requirements-ingest.txt and ~1 GB RAM).
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Vector size. MUST match the Qdrant collection; changing it means re-indexing.
EMBEDDING_DIMENSION=768
# groq (hosted LLM ranking, default) | local (cross-encoder; ~2 GB RAM) | none (keep search order).
RERANKER_BACKEND=groq

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Grounded answers + reranking + WhatsApp voice-note transcription. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Embeddings + website voice. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
VOICE_TOKEN_TTL_SECONDS=60
VOICE_MAX_SESSION_SECONDS=600
VOICE_IDLE_TIMEOUT_SECONDS=90
VOICE_MAX_CONCURRENT_SESSIONS=20
VOICE_MAX_SESSIONS_PER_IP=3

# ---------------------------------------------------------------------------
# Viewings
# ---------------------------------------------------------------------------
VIEWING_TIMEZONE=Africa/Cairo
VIEWING_DAY_START_HOUR=10
VIEWING_DAY_END_HOUR=18
VIEWING_SLOT_MINUTES=60
# Customers must book at least this far ahead.
BOOKING_MIN_NOTICE_HOURS=1
# An unconfirmed request frees its slot after this long.
BOOKING_HOLD_TTL_HOURS=24

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API). Leave all four empty to disable the channel.
# ---------------------------------------------------------------------------
# Any string you choose; paste the same value into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Meta app -> Settings -> Basic -> App secret (verifies webhook signatures).
WHATSAPP_APP_SECRET=
# Permanent system-user access token with whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Only for the optional open-wa gateway (app/channels/whatsapp.ts).
WHATSAPP_GATEWAY_SECRET=

# ---------------------------------------------------------------------------
# Staff alerts - set at least one (all optional, any combination)
# ---------------------------------------------------------------------------
# Slack / Discord / Teams-compatible incoming webhook.
STAFF_WEBHOOK_URL=
# Telegram: create a bot with @BotFather, send it a message, read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SMTP e-mail (Brevo / Gmail app password / Resend SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
STAFF_EMAIL_TO=
# WhatsApp text to your sales line (only delivered inside Meta's 24-hour window; prefer the others).
STAFF_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Document ingestion (offline script)
# ---------------------------------------------------------------------------
FILE_MAX_SIZE=
FILE_DEFAULT_CHUNK_SIZE=1500
FILE_CHUNK_OVERLAP=100

# ---------------------------------------------------------------------------
# Demo listings
# ---------------------------------------------------------------------------
# Listings ingested from a file whose name contains one of these markers are TEST data.
# They are hidden from the website, search and the assistant unless SHOW_DEMO_LISTINGS=true,
# and then every one is labelled "Demo listing - not for sale".
SHOW_DEMO_LISTINGS=false
DEMO_SOURCE_MARKERS=test_,demo,sample
